{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfin-ideas/rules/promises",
  "title": "rules: promises",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "draft",
    "voice",
    "review",
    "edit_window",
    "questions",
    "notes",
    "committee_window",
    "not_now",
    "team_by",
    "impact",
    "sign_in",
    "session",
    "ones"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_chars_to_check",
        "kept_days"
      ],
      "properties": {
        "min_chars_to_check": {
          "type": "integer",
          "minimum": 1
        },
        "kept_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_seconds"
      ],
      "properties": {
        "max_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decide_by_working_days"
      ],
      "properties": {
        "decide_by_working_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "edit_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_days"
      ],
      "properties": {
        "max_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "questions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_options_days",
        "answer_default_days",
        "deadline_hour",
        "reminder_hours_before",
        "extend_by_days"
      ],
      "properties": {
        "answer_options_days": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "answer_default_days": {
          "type": "integer",
          "minimum": 1
        },
        "deadline_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "reminder_hours_before": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "extend_by_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_reason_min_chars",
        "reversal_note_min_chars",
        "teamup_note_min_chars",
        "merge_note_min_chars"
      ],
      "properties": {
        "decision_reason_min_chars": {
          "type": "integer",
          "minimum": 1
        },
        "reversal_note_min_chars": {
          "type": "integer",
          "minimum": 1
        },
        "teamup_note_min_chars": {
          "type": "integer",
          "minimum": 1
        },
        "merge_note_min_chars": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "committee_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "days",
        "extend_by_days",
        "max_months"
      ],
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 1
        },
        "extend_by_days": {
          "type": "integer",
          "minimum": 1
        },
        "max_months": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "not_now": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "return_options_months",
        "return_default_months"
      ],
      "properties": {
        "return_options_months": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "return_default_months": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "team_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "working_days"
      ],
      "properties": {
        "working_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_days"
      ],
      "properties": {
        "check_days": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      }
    },
    "sign_in": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_digits",
        "code_valid_minutes",
        "code_tries",
        "resend_after_seconds"
      ],
      "properties": {
        "code_digits": {
          "type": "integer",
          "minimum": 4,
          "maximum": 10
        },
        "code_valid_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "code_tries": {
          "type": "integer",
          "minimum": 1
        },
        "resend_after_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hours"
      ],
      "properties": {
        "hours": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ones": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number_change_days",
        "number_max"
      ],
      "properties": {
        "number_change_days": {
          "type": "integer",
          "minimum": 1
        },
        "number_max": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
