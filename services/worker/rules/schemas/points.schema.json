{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfin-ideas/rules/points",
  "title": "rules: points",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "submission": {
      "type": "object",
      "properties": {
        "points": {
          "type": "number",
          "minimum": 0
        },
        "monthly_cap": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "points",
        "monthly_cap"
      ],
      "additionalProperties": false
    },
    "joined_with_context": {
      "type": "object",
      "properties": {
        "points": {
          "type": "number",
          "minimum": 0
        },
        "monthly_cap": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "points",
        "monthly_cap"
      ],
      "additionalProperties": false
    },
    "strong_canvas": {
      "type": "object",
      "properties": {
        "points": {
          "type": "number",
          "minimum": 0
        },
        "monthly_cap": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "points",
        "monthly_cap"
      ],
      "additionalProperties": false
    },
    "accepted_into_cluster": {
      "type": "object",
      "properties": {
        "originator": {
          "type": "number",
          "minimum": 0
        },
        "joiner": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "originator",
        "joiner"
      ],
      "additionalProperties": false
    },
    "shortlisted": {
      "type": "object",
      "properties": {
        "originator": {
          "type": "number",
          "minimum": 0
        },
        "joiner": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "originator",
        "joiner"
      ],
      "additionalProperties": false
    },
    "presented": {
      "type": "object",
      "properties": {
        "presenter": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "presenter"
      ],
      "additionalProperties": false
    },
    "accepted": {
      "type": "object",
      "properties": {
        "originator": {
          "type": "number",
          "minimum": 0
        },
        "joiner": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "originator",
        "joiner"
      ],
      "additionalProperties": false
    },
    "shipped_or_resolved": {
      "type": "object",
      "properties": {
        "originator": {
          "type": "number",
          "minimum": 0
        },
        "joiner": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "originator",
        "joiner"
      ],
      "additionalProperties": false
    },
    "working_group_member_shipped": {
      "type": "number",
      "minimum": 0
    },
    "appeal_overturned": {
      "const": "restore_forfeited"
    }
  },
  "required": [
    "version",
    "submission",
    "joined_with_context",
    "strong_canvas",
    "accepted_into_cluster",
    "shortlisted",
    "presented",
    "accepted",
    "shipped_or_resolved",
    "working_group_member_shipped",
    "appeal_overturned"
  ],
  "additionalProperties": false
}
