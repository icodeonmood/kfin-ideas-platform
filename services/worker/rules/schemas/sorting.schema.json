{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfin-ideas/rules/sorting",
  "title": "rules: sorting",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "affects", "areas", "helpers", "review_routing"],
  "$defs": {
    "label": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[^\\n]+$" },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shown", "more"],
      "properties": {
        "shown": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/label" } },
        "more": { "type": "array", "items": { "$ref": "#/$defs/label" } }
      }
    }
  },
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "affects": { "$ref": "#/$defs/list" },
    "areas": { "$ref": "#/$defs/list" },
    "helpers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/label" } },
    "review_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "areas"],
      "properties": {
        "default": { "enum": ["any_reviewer"] },
        "areas": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" }
          }
        }
      }
    }
  }
}
