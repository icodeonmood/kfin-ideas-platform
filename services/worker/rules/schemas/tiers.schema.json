{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfin-ideas/rules/tiers",
  "title": "rules: tiers",
  "type": "object",
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "tiers": {
      "type": "object",
      "propertyNames": { "enum": ["1", "2", "3", "4", "5", "6", "7"] },
      "minProperties": 7,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "hours_month": { "type": "number", "minimum": 0 },
          "money_year": { "type": "number", "minimum": 0 }
        },
        "required": ["hours_month", "money_year"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "tiers"],
  "additionalProperties": false
}
