{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfin-ideas/rules/drafting",
  "title": "rules: drafting",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "parts_from_chars",
    "similar_from_chars",
    "run_stale_seconds",
    "latency_days",
    "max_message_chars",
    "max_messages",
    "default_means_ms",
    "affects",
    "area"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "parts_from_chars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "similar_from_chars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "run_stale_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 600
    },
    "latency_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "max_message_chars": {
      "type": "integer",
      "minimum": 100,
      "maximum": 20000
    },
    "max_messages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "default_means_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "often",
        "who",
        "value",
        "area",
        "similar"
      ],
      "properties": {
        "title": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "often": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "who": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "value": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "area": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "similar": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        }
      }
    },
    "affects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "cues"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "cues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 40
            },
            "maxItems": 30
          }
        }
      }
    },
    "area": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "cues"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "cues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 40
            },
            "maxItems": 30
          }
        }
      }
    }
  }
}
