{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfin-ideas/rules/reason-codes",
  "title": "rules: reason-codes",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z_]+$"
          },
          "used_for": {
            "type": "array",
            "items": {
              "enum": [
                "decline",
                "park",
                "gate",
                "review"
              ]
            },
            "minItems": 1
          },
          "plain_words": {
            "type": "string",
            "minLength": 10
          }
        },
        "required": [
          "code",
          "used_for",
          "plain_words"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "codes"
  ],
  "additionalProperties": false
}
