{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfin-ideas/agents/collation/0.1.0",
  "title": "collation output",
  "type": "object",
  "additionalProperties": false,
  "required": ["strengths", "concerns", "conditions"],
  "properties": {
    "strengths": { "$ref": "#/$defs/themes" },
    "concerns": { "$ref": "#/$defs/themes" },
    "conditions": {
      "type": "array", "maxItems": 20,
      "items": { "type": "object", "additionalProperties": false, "required": ["text", "members"],
        "properties": { "text": { "type": "string", "minLength": 3, "maxLength": 300 },
                        "members": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^Member [0-9]{1,2}$" } } } }
    }
  },
  "$defs": {
    "themes": {
      "type": "array", "maxItems": 20,
      "items": { "type": "object", "additionalProperties": false, "required": ["theme", "count", "members"],
        "properties": { "theme": { "type": "string", "minLength": 3, "maxLength": 120 },
                        "count": { "type": "integer", "minimum": 1, "maximum": 30 },
                        "members": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^Member [0-9]{1,2}$" } } } }
    }
  }
}
