{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfin-ideas/agents/prescore/0.1.0",
  "title": "prescore output",
  "type": "object",
  "additionalProperties": false,
  "required": ["scores"],
  "properties": {
    "scores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "value", "rationale", "evidence"],
        "properties": {
          "dimension": { "type": "string", "pattern": "^[a-z_]{2,40}$" },
          "value": { "type": "integer", "minimum": 1, "maximum": 5 },
          "rationale": { "type": "string", "minLength": 5, "maxLength": 320 },
          "evidence": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 40 } }
        }
      }
    }
  }
}
