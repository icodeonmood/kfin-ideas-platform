{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfin-ideas/agents/cluster-summary/0.1.0",
  "title": "cluster-summary output",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "problem", "variations", "solution", "lobs", "roles_affected", "open_questions"],
  "properties": {
    "name": { "type": "string", "minLength": 3, "maxLength": 80 },
    "description": { "type": "string", "minLength": 10, "maxLength": 220 },
    "problem": { "type": "string", "minLength": 20, "maxLength": 1500 },
    "variations": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member", "note"],
        "properties": {
          "member": { "type": "string", "pattern": "^M[0-9]{1,2}$" },
          "note": { "type": "string", "minLength": 3, "maxLength": 300 }
        }
      }
    },
    "solution": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "credit"],
        "properties": {
          "text": { "type": "string", "minLength": 5, "maxLength": 600 },
          "credit": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "pattern": "^M[0-9]{1,2}$" } }
        }
      }
    },
    "lobs": { "type": "array", "maxItems": 12, "items": { "type": "string", "pattern": "^LOB-[a-z0-9-]+$" } },
    "roles_affected": { "type": "array", "maxItems": 12, "items": { "type": "string", "pattern": "^ROLE-[a-z0-9-]+$" } },
    "open_questions": { "type": "array", "maxItems": 5, "items": { "type": "string", "minLength": 5, "maxLength": 300 } }
  }
}
