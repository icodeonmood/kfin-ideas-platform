{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfin-ideas/agents/pitch-prep/0.1.0",
  "title": "pitch-prep output",
  "type": "object",
  "additionalProperties": false,
  "required": ["slides"],
  "properties": {
    "slides": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "points"],
        "properties": {
          "title": { "type": "string", "minLength": 3, "maxLength": 80 },
          "points": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "minLength": 3, "maxLength": 140 } }
        }
      }
    }
  }
}
