{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfin-ideas/agents/reason-writer/0.1.0",
  "title": "reason-writer output",
  "type": "object",
  "additionalProperties": false,
  "required": ["reason", "what_would_change", "feedback_points"],
  "properties": {
    "reason": { "type": "string", "minLength": 20, "maxLength": 700 },
    "what_would_change": { "type": "string", "minLength": 5, "maxLength": 500 },
    "feedback_points": { "type": "array", "maxItems": 4, "items": { "type": "string", "minLength": 5, "maxLength": 200 } }
  }
}
