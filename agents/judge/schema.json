{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfin-ideas/agents/judge/0.1.0",
  "title": "judge output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results",
    "best_same"
  ],
  "properties": {
    "results": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cid",
          "label",
          "reason",
          "confidence"
        ],
        "properties": {
          "cid": {
            "type": "string",
            "pattern": "^(IDEA-[0-9]{4}-[0-9]{6}|CL-[0-9]{4}|SOL-[0-9]{4}|DEC-[0-9]{4}-[0-9]{4})$"
          },
          "label": {
            "enum": [
              "same",
              "related",
              "different"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "best_same": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
