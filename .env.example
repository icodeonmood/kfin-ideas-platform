# Copy to .env for local development. Never commit .env. Synthetic data only.

# --- App ---
WORKER_URL=http://localhost:8000
INTERNAL_API_TOKEN=change-me-internal-dev-token      # web -> worker /internal/*; 32+ random chars in UAT/prod (vault)
APP_ENV=dev                                  # dev | uat | prod
APP_BASE_URL=http://localhost:3000
# The other ways in (S-H3, BLD-A192), from IT: the 1% Club mailbox and the Teams app link (https). Each also needs its
# switch (intake.email, intake.teams). Empty keeps that way "Coming soon".
INTAKE_EMAIL_ADDRESS=
TEAMS_APP_LINK=
SESSION_SECRET=change-me-32-bytes-min
CONTRIBUTOR_HMAC_SECRET=change-me            # used for CTR- codes; in UAT/prod comes from the vault
VAULT_ENCRYPTION_KEY=change-me               # pseudonym vault and encrypted draft columns; vault-managed in UAT/prod
PSEUDONYM_VAULT_KEY=                         # worker only: the pseudonym vault's own key; empty in dev (shared key); required in UAT/prod (BLD-098)
KFIN_EMAIL_DOMAINS=kfintech.com,kfintech.example   # warn instead of block; kfintech.example = synthetic users (BLD-035)

# --- Database ---
DATABASE_URL=postgres://ideas:ideas@localhost:5432/ideas?sslmode=disable

# --- Company repo ---
COMPANY_REPO_PATH=./.data/kfin-ideas
# Internal Git remote (IT, by Wed 11 Nov); empty = local only. Keep comments off lines with empty values:
# Docker Compose reads a trailing comment after an empty value as the value itself.
COMPANY_REPO_REMOTE=
REPO_WRITER_AUTHOR="Ideas Platform Bot <ideas-bot@localhost>"

# --- Identity ---
OIDC_MODE=mock                               # mock | entra
OIDC_ISSUER=http://localhost:8090/default      # mock OIDC on 8090 (BLD-018)
MOCK_OIDC_PORT=8090
OIDC_CLIENT_ID=ideas-platform
OIDC_CLIENT_SECRET=
PRIVACY_NOTICE_VERSION=0.1-draft

# --- Models (through the gateway only) ---
LLM_MODE=fake                                # fake | anthropic | bedrock
LLM_FAST_MODEL=claude-haiku-5-5
LLM_REASONING_MODEL=claude-sonnet-5-5
# Only if LLM_MODE=anthropic and InfoSec has approved (D1). Never commit a key.
ANTHROPIC_API_KEY=
AWS_REGION=ap-south-1                        # only if LLM_MODE=bedrock
LLM_MAX_REASONING_CONCURRENCY=20
LLM_DAILY_BUDGET_INR=5000
LLM_USD_TO_INR=88                            # finance's rate for cost logging and the daily budget
LLM_REFUSAL_FALLBACK=true                    # Claude API route, Sonnet only: server-side fallback on a decline
LLM_FAKE_LATENCY=none                        # none | realistic (scan timing tests, AT-B4-09)

# --- Embeddings ---
EMBEDDINGS_MODE=hash                         # hash | bge-m3
EMBEDDINGS_MODEL_PATH=./.models/bge-m3

# --- Voice notes in quick capture (DEC-096) ---
SPEECH_MODE=fake                             # fake | local | sarvam (hosted: off until InfoSec and the DPO approve)
SPEECH_LOCAL_ENGINE=faster-whisper           # faster-whisper | indic-conformer (coming soon)
SPEECH_MODEL_PATH=                           # local only: model files (worker image built with WITH_SPEECH=1)
SPEECH_ENGINE_URL=                           # the isolated speech service (http://speech:8300); required outside dev and test
SPEECH_MODEL_DIR=./.models/speech            # host folder mounted read-only into the speech service
# Start the speech service with COMPOSE_PROFILES=speech make up. Its token is set in infra/docker-compose.yml for dev;
# in UAT and prod SPEECH_SERVICE_TOKEN goes in the database env file (worker and speech service only).
# Never put SPEECH_SERVICE_TOKEN in this file: .env also reaches the web app (compose blanks it there anyway).
SPEECH_HOSTED_APPROVAL=                      # the InfoSec and DPO approval reference; empty keeps hosted routes off
SPEECH_HOSTED_KEY=                           # hosted only. Never commit a key

# --- File store and virus scan ---
S3_ENDPOINT=http://localhost:9000            # S3-compatible; Versity S3 Gateway in dev (BLD-017)
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
S3_BUCKET_QUARANTINE=ideas-quarantine
S3_BUCKET_CLEAN=ideas-clean
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Email ---
EMAIL_MODE=smtp                              # smtp (Mailpit in dev) | graph
SMTP_URL=smtp://localhost:1025
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_SERVICE_MAILBOX=

# --- Eval ---
GOLDEN_SEED=42

# --- A second local stack (optional; BLD-200) ---
# To run a second stack beside the first (for example in a git worktree), uncomment and move every host port,
# and point WORKER_URL, APP_BASE_URL, DATABASE_URL, S3_ENDPOINT, SMTP_URL and OIDC_ISSUER above at the new ports.
# Leave all of these unset for the usual single stack; the defaults are the ports used above.
# COMPOSE_PROJECT_NAME=kfin-ideas-b
# POSTGRES_PORT=5532
# WEB_HOST_PORT=3100
# WORKER_HOST_PORT=8100
# S3_HOST_PORT=9100
# CLAMAV_HOST_PORT=3410
# MAILPIT_SMTP_HOST_PORT=1125
# MAILPIT_UI_HOST_PORT=8125
# E2E_BASE_URL=http://localhost:3100
# On a small dev VM the second stack can skip its own scanner and use the first stack's:
# WORKER_CLAMAV_HOST=host.docker.internal
# WORKER_CLAMAV_PORT=3310
# STACK_UP_FLAGS=--scale clamav=0
